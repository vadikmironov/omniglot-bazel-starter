Fix invalid escape sequences in the OpenSSL props literals

Both constants are non-raw bytes literals containing \libcrypto and
\libssl, so Python reads \l as an escape. That is a SyntaxWarning today
and compiling build.py with -W error::SyntaxWarning already fails, so
the file stops parsing once invalid escapes become an error.

diff --git a/cpython-windows/build.py b/cpython-windows/build.py
--- a/cpython-windows/build.py
+++ b/cpython-windows/build.py
@@ -335,7 +335,7 @@
         normalized_patch.unlink()
 
 
-OPENSSL_PROPS_REMOVE_RULES_LEGACY = b"""
+OPENSSL_PROPS_REMOVE_RULES_LEGACY = rb"""
   <ItemGroup>
     <_SSLDLL Include="$(opensslOutDir)\libcrypto$(_DLLSuffix).dll" />
     <_SSLDLL Include="$(opensslOutDir)\libcrypto$(_DLLSuffix).pdb" />
@@ -350,7 +350,7 @@
   </Target>
 """
 
-OPENSSL_PROPS_REMOVE_RULES = b"""
+OPENSSL_PROPS_REMOVE_RULES = rb"""
   <ItemGroup>
     <_SSLDLL Include="$(opensslOutDir)\libcrypto$(_DLLSuffix).dll" />
     <_SSLDLL Include="$(opensslOutDir)\libcrypto$(_DLLSuffix).pdb" />
