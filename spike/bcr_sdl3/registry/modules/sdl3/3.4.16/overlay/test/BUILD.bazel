load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

# SDL's non-interactive test programs, run the way SDL's ctest runs them:
# headless on the dummy video and audio drivers, with assertions fatal.
# https://github.com/libsdl-org/SDL/blob/release-3.4.16/test/CMakeLists.txt#L596-L608
#
# Not here: testyuv reads its resource files next to the executable (via
# SDL_GetBasePath), which a Bazel test has no way to arrange; testsymbols
# checks the exported symbols of the shared library; pretest is 32-bit
# Windows only. Everything else in this directory is interactive.
_ENV = {
    "SDL_ASSERT": "abort",
    "SDL_AUDIO_DRIVER": "dummy",
    "SDL_VIDEO_DRIVER": "dummy",
}

# ctest runs testautomation and testplatform a second time with every CPU
# feature masked off.
# https://github.com/libsdl-org/SDL/blob/release-3.4.16/test/CMakeLists.txt#L681-L688
_ENV_NO_SIMD = dict(_ENV, SDL_CPU_FEATURE_MASK = "-all")

# The automated suite. Its main() comes from testautomation.c through
# SDL_main.h, hence alwayslink; the library lets the two runs below share
# the objects. It reads the build config and a private header.
# https://github.com/libsdl-org/SDL/blob/release-3.4.16/test/CMakeLists.txt#L324-L325
cc_library(
    name = "testautomation_lib",
    testonly = True,
    srcs = glob([
        "testautomation*.c",
        "testautomation*.h",
    ]),
    alwayslink = True,
    deps = [
        "@sdl3",
        "@sdl3//:sdl3_test",
        "@sdl3//:test_internals",
    ],
)

cc_test(
    name = "testautomation",
    size = "medium",
    env = _ENV,
    deps = [":testautomation_lib"],
)

cc_test(
    name = "testautomation_no_simd",
    size = "medium",
    env = _ENV_NO_SIMD,
    deps = [":testautomation_lib"],
)

cc_test(
    name = "testplatform_no_simd",
    size = "small",
    srcs = ["testplatform.c"],
    env = _ENV_NO_SIMD,
    deps = [
        "@sdl3",
        "@sdl3//:sdl3_test",
    ],
)

# One target per NONINTERACTIVE executable, with the arguments and, where
# CMake sets one above the default, the timeout ctest uses. testtimer
# asserts on wall-clock durations, which other tests running alongside on a
# shared runner can break, so it runs alone.
# https://github.com/libsdl-org/SDL/blob/release-3.4.16/test/CMakeLists.txt#L332-L444
[
    cc_test(
        name = name,
        size = "small",
        timeout = timeout,
        srcs = [name + ".c"],
        args = args,
        env = _ENV,
        tags = tags,
        deps = [
            "@sdl3",
            "@sdl3//:sdl3_test",
        ] + extra_deps,
    )
    for name, args, timeout, extra_deps, tags in [
        ("testatomic", [], "short", [], []),
        ("testbounds", [], "short", [], []),
        ("testerror", [], "short", [], []),
        # Includes SDL_evdev_capabilities.c from src/ textually.
        ("testevdev", [], "short", ["@sdl3//:test_internals"], []),
        ("testfile", [], "short", [], []),
        ("testfilesystem", [], "short", [], []),
        ("testlocale", [], "short", [], []),
        ("testplatform", [], "short", [], []),
        ("testpower", [], "short", [], []),
        ("testqsort", [], "short", [], []),
        ("testrwlock", [], "moderate", [], []),
        ("testthread", [], "moderate", [], []),
        ("testtimer", ["--no-interactive"], "moderate", [], ["exclusive"]),
        ("testver", [], "short", [], []),
        ("torturethread", [], "moderate", [], []),
    ]
]

# testsem asserts that a 2 s SDL_WaitSemaphoreTimeout ends within 2050 ms.
# On macOS, where SDL's semaphore is the generic one over a condition
# variable, GitHub-hosted runners measured 2070 to 2148 ms even with nothing
# else running, so the test is off there; the same window holds on Linux
# and Windows.
# https://github.com/libsdl-org/SDL/blob/release-3.4.16/test/testsem.c#L106-L126
cc_test(
    name = "testsem",
    size = "small",
    timeout = "moderate",
    srcs = ["testsem.c"],
    args = ["10"],
    env = _ENV,
    tags = ["exclusive"],
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        "@sdl3",
        "@sdl3//:sdl3_test",
    ],
)
