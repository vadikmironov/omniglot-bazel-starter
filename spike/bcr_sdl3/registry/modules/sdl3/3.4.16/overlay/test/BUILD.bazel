load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

# SDL's non-interactive test programs, run the way SDL's ctest runs them:
# headless on the dummy video and audio drivers, with assertions fatal.
# https://github.com/libsdl-org/SDL/blob/release-3.4.16/test/CMakeLists.txt#L596-L608
#
# Every program test/CMakeLists.txt marks NONINTERACTIVE is here, including
# the ones it marks so only when the dummy drivers are on. The one left out is
# pretest, which upstream builds for 32-bit Windows only.
# https://github.com/libsdl-org/SDL/blob/release-3.4.16/test/CMakeLists.txt#L409-L411
# https://github.com/libsdl-org/SDL/blob/release-3.4.16/test/CMakeLists.txt#L497-L505
_ENV = {
    "SDL_ASSERT": "abort",
    "SDL_AUDIO_DRIVER": "dummy",
    "SDL_VIDEO_DRIVER": "dummy",
}

# ctest runs testautomation and testplatform a second time with every CPU
# feature masked off.
# https://github.com/libsdl-org/SDL/blob/release-3.4.16/test/CMakeLists.txt#L681-L688
_ENV_NO_SIMD = dict(
    _ENV,
    SDL_CPU_FEATURE_MASK = "-all",
)

# Upstream compiles every test with HAVE_BUILD_CONFIG, which some of them read
# to include SDL's build config or SDL_internal.h; without it testevdev passes
# without testing anything.
# https://github.com/libsdl-org/SDL/blob/release-3.4.16/test/CMakeLists.txt#L144
_DEFINES = ["HAVE_BUILD_CONFIG"]

_DEPS = [
    "@sdl3",
    "@sdl3//:sdl3_test",
    "@sdl3//:test_internals",
]

# SDL's tests include its private headers by relative path ("../src/...") and
# get the build config through test_internals, which exports nothing of its
# own, so layering_check is off for them. A consumer depending on @sdl3 alone
# passes it.
_FEATURES = ["-layering_check"]

# testver is C90 upstream.
# https://github.com/libsdl-org/SDL/blob/release-3.4.16/test/CMakeLists.txt#L430
_C90 = select({
    "@rules_cc//cc/compiler:clang": ["-std=c90"],
    "@rules_cc//cc/compiler:gcc": ["-std=c90"],
    "//conditions:default": [],
})

# The automated suite. Its main() comes from testautomation.c through
# SDL_main.h, hence alwayslink; the library lets the two runs below share the
# objects.
# https://github.com/libsdl-org/SDL/blob/release-3.4.16/test/CMakeLists.txt#L324-L325
cc_library(
    name = "testautomation_lib",
    testonly = True,
    srcs = glob([
        "testautomation*.c",
        "testautomation*.h",
    ]),
    features = _FEATURES,
    local_defines = _DEFINES,
    deps = _DEPS,
    alwayslink = True,
)

cc_test(
    name = "testautomation",
    size = "medium",
    env = _ENV,
    features = _FEATURES,
    deps = [":testautomation_lib"],
)

cc_test(
    name = "testautomation_no_simd",
    size = "medium",
    env = _ENV_NO_SIMD,
    features = _FEATURES,
    deps = [":testautomation_lib"],
)

cc_test(
    name = "testplatform_no_simd",
    size = "small",
    srcs = ["testplatform.c"],
    env = _ENV_NO_SIMD,
    features = _FEATURES,
    local_defines = _DEFINES,
    deps = _DEPS,
)

# One target per NONINTERACTIVE program that needs no arguments, with the
# timeout ctest gives it where that is above the default.
# https://github.com/libsdl-org/SDL/blob/release-3.4.16/test/CMakeLists.txt#L321-L444
[
    cc_test(
        name = name,
        size = "small",
        timeout = timeout,
        srcs = [name + ".c"],
        copts = copts,
        env = _ENV,
        features = _FEATURES,
        local_defines = _DEFINES,
        deps = _DEPS,
    )
    for name, timeout, copts in [
        ("testatomic", "short", []),
        ("testaudioinfo", "short", []),
        ("testbounds", "short", []),
        ("testdisplayinfo", "short", []),
        ("testerror", "short", []),
        ("testevdev", "short", []),
        ("testfile", "short", []),
        ("testfilesystem", "short", []),
        ("testkeys", "short", []),
        ("testlocale", "short", []),
        ("testplatform", "short", []),
        ("testpower", "short", []),
        ("testqsort", "short", []),
        ("testrwlock", "moderate", []),
        ("testthread", "moderate", []),
        ("testver", "short", _C90),
        ("torturethread", "moderate", []),
    ]
]

# testsymbols takes the address of every function SDL exports, which against
# a static library catches a source file missing from the lists above.
# https://github.com/libsdl-org/SDL/blob/release-3.4.16/test/CMakeLists.txt#L340
cc_test(
    name = "testsymbols",
    size = "small",
    srcs = ["testsymbols.c"],
    args = [
        "0",
        "10",
        "20",
        "40",
        "80",
        "160",
        "320",
        "640",
    ],
    env = _ENV,
    features = _FEATURES,
    local_defines = _DEFINES,
    deps = _DEPS,
)

# ctest runs testyuv with --automated alone: the automated check generates its
# own images. Given a file name as well, the program frees that argv string on
# exit and crashes.
# https://github.com/libsdl-org/SDL/blob/release-3.4.16/test/CMakeLists.txt#L435
cc_test(
    name = "testyuv",
    size = "small",
    srcs = [
        "testutils.c",
        "testutils.h",
        "testyuv.c",
        "testyuv_cvt.c",
        "testyuv_cvt.h",
    ],
    args = ["--automated"],
    env = _ENV,
    features = _FEATURES,
    local_defines = _DEFINES,
    deps = _DEPS,
)

# testprocess starts childprocess through SDL's process API and checks
# arguments, environment, exit codes, signals and pipes. ctest passes it the
# absolute path of childprocess; bazel_testprocess_main.cc resolves both
# programs from the runfiles instead, which on Windows are a manifest rather
# than a directory. patches/0001-testprocess-bounded-EOF-search.patch is
# upstream's fix for an out-of-bounds read in this test that crashes it on
# Windows ARM64.
# https://github.com/libsdl-org/SDL/blob/release-3.4.16/test/CMakeLists.txt#L456-L463
# https://github.com/libsdl-org/SDL/commit/32c19b9dc8c229e239434fedc94541c6abb3f84a
cc_binary(
    name = "childprocess",
    testonly = True,
    srcs = ["childprocess.c"],
    features = _FEATURES,
    local_defines = _DEFINES,
    deps = _DEPS,
)

cc_binary(
    name = "testprocess_bin",
    testonly = True,
    srcs = ["testprocess.c"],
    features = _FEATURES,
    local_defines = _DEFINES,
    deps = _DEPS,
)

cc_test(
    name = "testprocess",
    size = "small",
    srcs = ["bazel_testprocess_main.cc"],
    args = [
        "$(rlocationpath :testprocess_bin)",
        "$(rlocationpath :childprocess)",
    ],
    data = [
        ":childprocess",
        ":testprocess_bin",
    ],
    env = _ENV,
    features = _FEATURES,
    deps = ["@rules_cc//cc/runfiles"],
)

# The two tests below assert on wall-clock durations, so they run alone.
#
# testtimer checks that consecutive 1 ms delays stay regular; a GitHub-hosted
# macOS runner stalled one of them for 109 ms once in a thousand iterations,
# so a failed run is retried.
# https://github.com/libsdl-org/SDL/blob/release-3.4.16/test/testtimer.c
cc_test(
    name = "testtimer",
    size = "small",
    timeout = "moderate",
    srcs = ["testtimer.c"],
    args = ["--no-interactive"],
    env = _ENV,
    features = _FEATURES,
    flaky = True,
    local_defines = _DEFINES,
    tags = ["exclusive"],
    deps = _DEPS,
)

# testsem asserts that a 2 s SDL_WaitSemaphoreTimeout ends within 2050 ms.
# On macOS, where SDL's semaphore is the generic one over a condition
# variable, GitHub-hosted runners measured 2070 to 2151 ms in 11 of 12 runs,
# with and without Bazel's sandbox, so the test is off there; the window
# holds on Linux and Windows.
# https://github.com/libsdl-org/SDL/blob/release-3.4.16/test/testsem.c#L106-L126
cc_test(
    name = "testsem",
    size = "small",
    timeout = "moderate",
    srcs = ["testsem.c"],
    args = ["10"],
    env = _ENV,
    features = _FEATURES,
    local_defines = _DEFINES,
    tags = ["exclusive"],
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = _DEPS,
)
