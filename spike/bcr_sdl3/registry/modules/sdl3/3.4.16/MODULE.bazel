module(
    name = "sdl3",
    version = "3.4.16",
    bazel_compatibility = [">=7.2.1"],
    compatibility_level = 1,
)

# macOS: the Objective-C sources need apple_support's C++ toolchain, which
# Bazel only picks over the autoconfigured one if apple_support is declared
# before rules_cc (toolchains register in bazel_dep order).
bazel_dep(name = "apple_support", version = "2.3.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.16")

# Linux: headers only. SDL loads these libraries at runtime by soname.
bazel_dep(name = "alsa_lib", version = "1.2.9.bcr.4")
bazel_dep(name = "libx11", version = "1.8.12.bcr.5")
bazel_dep(name = "libxcursor", version = "1.2.3")
bazel_dep(name = "libxext", version = "1.3.6")
bazel_dep(name = "libxfixes", version = "6.0.2")
bazel_dep(name = "libxi", version = "1.8.2")
bazel_dep(name = "libxrandr", version = "1.5.4")
bazel_dep(name = "wayland", version = "1.24.0.bcr.1")
bazel_dep(name = "xkbcommon", version = "1.9.2.bcr.beta.1")

# wayland resolves libffi through 3.4.7.bcr.3, which does not build on Linux aarch64.
bazel_dep(name = "libffi", version = "3.4.7.bcr.5")
