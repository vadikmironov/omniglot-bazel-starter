#
# Module-local MODULE.bazel segment for //tools/cpp/foreign_cc.
#
# The native tools rules_foreign_cc's cmake()/make()/meson() require, where its
# own do not cover every platform we build on. Each is registered from the root
# module, which outranks the toolchains rules_foreign_cc registers for itself.
#
#   cmake    Windows ARM64 only; the prebuilts upstream maps stop at x86_64.
#   ninja    Windows ARM64 only, same reason.
#
# pkg-config is no longer here: 0.16.0 takes it from the pkgconf registry
# module, which is what this repository used to register by hand.
#
# Included from the root MODULE.bazel (included files cannot themselves call
# include(), so the wiring lives there).
#
# m4 stays a host tool. 0.16.0 changed its default to a source build, and that
# build is gnulib, whose headers spell C99 `restrict` in a way MSVC rejects
# (regex.h and spawn.h fail to compile on both Windows x64 and ARM64). This is
# the opt-out the release documents, and it is what every earlier version did.
tools = use_extension("@rules_foreign_cc//foreign_cc:extensions.bzl", "tools")
tools.m4(mode = "system")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# rules_foreign_cc maps prebuilt cmake and ninja to x86_64 and i386 on Windows
# only. On ARM64 nothing matches and each falls through to its system entry,
# which means whatever the host happens to have on PATH. Both projects publish
# ARM64 binaries; these fill in the missing platform and are constrained to it,
# leaving the upstream prebuilts in charge everywhere else.
http_archive(
    name = "cmake_windows_arm64",
    build_file = "//tools/cpp/foreign_cc:cmake_windows_arm64.BUILD",
    sha256 = "d37ca89ec60aece080664ee936f7aaffdfdbde0a201b165c45ecfaf68a4c1fa9",
    strip_prefix = "cmake-3.31.8-windows-arm64",
    urls = ["https://github.com/Kitware/CMake/releases/download/v3.31.8/cmake-3.31.8-windows-arm64.zip"],
)

http_archive(
    name = "ninja_windows_arm64",
    build_file = "//tools/cpp/foreign_cc:ninja_windows_arm64.BUILD",
    sha256 = "f089535ab1536d3017628ac60542e731a4fda431417826a442308f0bb128330b",
    urls = ["https://github.com/ninja-build/ninja/releases/download/v1.13.0/ninja-winarm64.zip"],
)

register_toolchains(
    "//tools/cpp/foreign_cc:cmake_windows_arm64_toolchain",
    "//tools/cpp/foreign_cc:ninja_windows_arm64_toolchain",
)
