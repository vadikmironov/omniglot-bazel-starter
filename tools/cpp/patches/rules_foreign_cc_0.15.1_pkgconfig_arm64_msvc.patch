diff --git a/foreign_cc/built_tools/pkgconfig_build.bzl b/foreign_cc/built_tools/pkgconfig_build.bzl
index f21ee7f..14e80dd 100644
--- a/foreign_cc/built_tools/pkgconfig_build.bzl
+++ b/foreign_cc/built_tools/pkgconfig_build.bzl
@@ -139,6 +139,20 @@ def pkgconfig_tool(name, srcs, **kwargs):
         },
     )
 
+    # Strict superset of the "@platforms//os:windows" key it competes with in
+    # postfix_script below, so select() resolves it as the specialization
+    # rather than reporting an ambiguous match.
+    native.config_setting(
+        name = "msvc_compiler_arm64",
+        constraint_values = [
+            "@platforms//cpu:arm64",
+            "@platforms//os:windows",
+        ],
+        flag_values = {
+            "@bazel_tools//tools/cpp:compiler": "msvc-cl",
+        },
+    )
+
     native.alias(
         name = name,
         actual = select({
@@ -157,11 +171,21 @@ def pkgconfig_tool(name, srcs, **kwargs):
     make_variant(
         name = "{}_msvc_build".format(name),
         lib_source = srcs,
+        # detectenv-msvc.mak infers PLAT by preprocessing for _M_IX86/_M_AMD64
+        # only, so on ARM64 it stays empty: the output lands in release\ instead
+        # of release\$(PLAT)\ and LDFLAGS_ARCH falls through to /machine:x86,
+        # failing the link with LNK1112. Set both explicitly there.
         args = [
             "-f Makefile.vc",
             "CFG=release",
             "GLIB_PREFIX=\"$$EXT_BUILD_ROOT/external/%s\"" % Label("@glib_dev").workspace_name,
-        ],
+        ] + select({
+            ":msvc_compiler_arm64": [
+                "PLAT=arm64",
+                "LDFLAGS_ARCH=/machine:arm64",
+            ],
+            "//conditions:default": [],
+        }),
         out_binaries = ["pkg-config.exe"],
         env = {"INCLUDE": "$$EXT_BUILD_ROOT/external/%s" % Label("@glib_src").workspace_name},
         out_static_libs = [],
@@ -172,6 +196,7 @@ def pkgconfig_tool(name, srcs, **kwargs):
             "@gettext_runtime",
         ],
         postfix_script = select({
+            ":msvc_compiler_arm64": "cp release/arm64/pkg-config.exe $$INSTALLDIR/bin",
             "@platforms//os:windows": "cp release/x64/pkg-config.exe $$INSTALLDIR/bin",
             "//conditions:default": "",
         }),
