# Adds the external_include_paths feature, which this toolchain's hand-rolled
# cc_toolchain_config never implemented, so --features=external_include_paths
# (set in .bazelrc) is silently a no-op under --config=gcc_hermetic and
# external headers arrive as -I/-iquote instead of -isystem.
#
# Mirrors rules_cc's unix_cc_toolchain_config, which toolchains_llvm delegates
# to and is why the Clang toolchain is unaffected.
#
# Reported upstream: https://github.com/f0rmiga/gcc-toolchain/issues/215
--- a/toolchain/cc_toolchain_config.bzl
+++ b/toolchain/cc_toolchain_config.bzl
@@ -413,6 +413,36 @@
         ],
     )
 
+    # Mirrors rules_cc's unix_cc_toolchain_config: opt-in feature that routes
+    # external-repository headers through -isystem so their diagnostics do not
+    # trip a first-party -Werror build. Without it --features=external_include_paths
+    # is silently a no-op on this toolchain.
+    external_include_paths_feature = feature(
+        name = "external_include_paths",
+        flag_sets = [
+            flag_set(
+                actions = [
+                    ACTION_NAMES.preprocess_assemble,
+                    ACTION_NAMES.linkstamp_compile,
+                    ACTION_NAMES.c_compile,
+                    ACTION_NAMES.cpp_compile,
+                    ACTION_NAMES.cpp_header_parsing,
+                    ACTION_NAMES.cpp_module_compile,
+                    ACTION_NAMES.clif_match,
+                    ACTION_NAMES.objc_compile,
+                    ACTION_NAMES.objcpp_compile,
+                ],
+                flag_groups = [
+                    flag_group(
+                        flags = ["-isystem", "%{external_include_paths}"],
+                        iterate_over = "external_include_paths",
+                        expand_if_available = "external_include_paths",
+                    ),
+                ],
+            ),
+        ],
+    )
+
     library_search_directories_feature = feature(
         name = "library_search_directories",
         flag_sets = [
@@ -555,6 +585,7 @@
         [
             default_compile_flags_feature,
             include_paths_feature,
+            external_include_paths_feature,
             library_search_directories_feature,
             default_link_flags_feature,
             linker_lld_feature,
