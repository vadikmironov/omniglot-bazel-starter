# Backport of https://github.com/bazel-contrib/rules_foreign_cc/pull/1459
# ("fix pkgconfig on windows", merged 2026-02-06), which landed after the
# 0.15.1 release of 2025-06-24. Fixes upstream issue #1359.
#
# The MSVC pkg-config bootstrap hardcoded WORKSPACE-era external paths,
# external/glib_dev and external/glib_src. Under bzlmod those repos are
# canonically named, so the directories do not exist and nmake fails with:
#
#   .\pkg.c: fatal error C1083: Cannot open include file:
#   'msvc_recommended_pragmas.h': No such file or directory
#
# The transitions.bzl hunk is part of the same PR and coupled to it: passing a
# Label for `toolchain` requires the attr to be attr.label rather than
# attr.string.
diff --git a/foreign_cc/built_tools/pkgconfig_build.bzl b/foreign_cc/built_tools/pkgconfig_build.bzl
--- a/foreign_cc/built_tools/pkgconfig_build.bzl
+++ b/foreign_cc/built_tools/pkgconfig_build.bzl
@@ -160,10 +160,10 @@
         args = [
             "-f Makefile.vc",
             "CFG=release",
-            "GLIB_PREFIX=\"$$EXT_BUILD_ROOT/external/glib_dev\"",
+            "GLIB_PREFIX=\"$$EXT_BUILD_ROOT/external/%s\"" % Label("@glib_dev").workspace_name,
         ],
         out_binaries = ["pkg-config.exe"],
-        env = {"INCLUDE": "$$EXT_BUILD_ROOT/external/glib_src"},
+        env = {"INCLUDE": "$$EXT_BUILD_ROOT/external/%s" % Label("@glib_src").workspace_name},
         out_static_libs = [],
         out_shared_libs = [],
         deps = [
@@ -175,7 +175,7 @@
             "@platforms//os:windows": "cp release/x64/pkg-config.exe $$INSTALLDIR/bin",
             "//conditions:default": "",
         }),
-        toolchain = str(Label("//toolchains:preinstalled_nmake_toolchain")),
+        toolchain = Label("//toolchains:preinstalled_nmake_toolchain"),
         tags = tags,
         **kwargs
     )
diff --git a/foreign_cc/private/transitions.bzl b/foreign_cc/private/transitions.bzl
--- a/foreign_cc/private/transitions.bzl
+++ b/foreign_cc/private/transitions.bzl
@@ -27,7 +27,7 @@
     cfg = _extra_toolchains_transition,
     attrs = {
         # This attr is singular to make it selectable when used for add make toolchain variant.
-        "extra_toolchain": attr.string(
+        "extra_toolchain": attr.label(
             doc = "Additional toolchain to consider. Note, this is singular.",
             mandatory = True,
         ),
