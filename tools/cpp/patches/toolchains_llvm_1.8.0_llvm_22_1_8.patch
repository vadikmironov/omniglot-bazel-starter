# Back-ports LLVM 22.1.8, added upstream in
# https://github.com/bazel-contrib/toolchains_llvm/pull/780 after the 1.8.0
# release. Needed because clang-tidy 21 mis-parses __has_feature in libc++
# headers under modernize-use-trailing-return-type (llvm/llvm-project#168360,
# fixed in llvm main but not in the 21.x tags); LLVM 22 does not hit it.
#
# extra.jsonc is upstream's documented downstream slot for exactly this, so the
# checksums go there verbatim rather than into the generated table.
--- a/toolchain/distributions/extra.jsonc
+++ b/toolchain/distributions/extra.jsonc
@@ -26,4 +26,13 @@
     "description": "Downstream slot for additional bundled LLVM distributions. Empty in the upstream repository.",
     "base_url": {},
   },
+
+  // LLVM 22.1.8, back-ported from upstream PR #780, which landed after the
+  // 1.8.0 release. Checksums copied verbatim from github.jsonc at that commit;
+  // the URLs resolve through _DEFAULT_URL_TEMPLATE.
+  "LLVM-22.1.8-Linux-ARM64.tar.xz": "805efad2bb91cb4967fa569e0881d10c0f69c04461cf671cccbae19f547acc34",
+  "LLVM-22.1.8-Linux-X64.tar.xz": "df0e1ecf16caf3489a272a5eea4eec9b0d82878f6477fa309504f918a0006384",
+  "LLVM-22.1.8-macOS-ARM64.tar.xz": "f260f4f7c0d430828a81ae8a3826a1d63fc0963ec2459489308cc23b1f7eab4f",
+  "clang+llvm-22.1.8-aarch64-pc-windows-msvc.tar.xz": "de718c58ebbc5f61d58c17b90457fcf42983bc2c4a4aba3e010d108713bfd7f1",
+  "clang+llvm-22.1.8-x86_64-pc-windows-msvc.tar.xz": "d96c2cc1736f4eb7fa43cb9bbdf56d93551a9ae0a9aadb9c99c3c3b2b712a234",
 }
