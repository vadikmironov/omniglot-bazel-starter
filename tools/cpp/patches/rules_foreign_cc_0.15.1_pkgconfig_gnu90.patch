# Backport of https://github.com/bazel-contrib/rules_foreign_cc/pull/1458 (commit 329140e4a0ae),
# "pkgconfig: use the -std=gnu90 flag to compile", which fixes
# https://github.com/bazel-contrib/rules_foreign_cc/issues/1427.
#
# The bundled glib does not compile under GCC 15, whose default is C23.
# Upstream's line also carries an -isystem change from a later commit; only
# the -std=gnu90 addition is backported here.
--- a/foreign_cc/built_tools/pkgconfig_build.bzl
+++ b/foreign_cc/built_tools/pkgconfig_build.bzl
@@ -34,7 +34,7 @@
     frozen_arflags = flags_info.cxx_linker_static
 
     cc_path = tools_info.cc
-    cflags = flags_info.cc + ["-Wno-int-conversion"]  # Fix building with clang 15+
+    cflags = flags_info.cc + ["-Wno-int-conversion", "-std=gnu90"]  # Fix building with clang 15+
     sysroot_cflags = extract_sysroot_flags(cflags)
     non_sysroot_cflags = extract_non_sysroot_flags(cflags)
 
