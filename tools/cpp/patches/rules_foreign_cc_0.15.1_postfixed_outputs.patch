diff --git a/foreign_cc/private/framework/toolchains/macos_commands.bzl b/foreign_cc/private/framework/toolchains/macos_commands.bzl
--- a/foreign_cc/private/framework/toolchains/macos_commands.bzl
+++ b/foreign_cc/private/framework/toolchains/macos_commands.bzl
@@ -254,6 +254,44 @@
         abs_path = abs_path,
     )
 
+def resolve_postfixed_output(file):
+    # A build may decorate an artifact name with a configuration postfix
+    # (CMAKE_DEBUG_POSTFIX, or a project's own), so -c dbg produces libfood.a
+    # where libfoo.a was declared and the action fails on a missing output.
+    #
+    # Rather than guess the postfix, ask the build. CMake's file API reply names
+    # each target's artifact on disk, so a declared libfoo.a resolves through
+    # target foo to whatever it was actually called. Builds that leave no reply,
+    # such as make or ninja, fall through to reporting what was produced, since
+    # Bazel's own error names only the file that is missing.
+    return """\
+if [[ ! -e "{file}" ]]; then
+  _decl="{file}"
+  _dir="$(dirname "${{_decl}}")"
+  _base="$(basename "${{_decl}}")"
+  _target="${{_base%.*}}"
+  _target="${{_target#lib}}"
+  _found=""
+  for _tj in "${{BUILD_TMPDIR}}/.cmake/api/v1/reply/target-${{_target}}-"*.json; do
+    [[ -e "${{_tj}}" ]] || continue
+    _ondisk="$(grep -o '"nameOnDisk"[^,}}]*' "${{_tj}}" | head -n 1 | cut -d'"' -f4)"
+    if [[ -n "${{_ondisk}}" && -e "${{_dir}}/${{_ondisk}}" ]]; then
+      _found="${{_dir}}/${{_ondisk}}"
+      break
+    fi
+  done
+  if [[ -n "${{_found}}" ]]; then
+    echo "rules_foreign_cc: target ${{_target}} is on disk as $(basename "${{_found}}"), satisfying ${{_base}}"
+    cp -a "${{_found}}" "${{_decl}}"
+  else
+    echo "rules_foreign_cc: ${{_decl}} was not produced, and no target named ${{_target}} claims it"
+    find "${{_dir}}" -maxdepth 1 -type f -printf "rules_foreign_cc:   produced %f\n" 2>/dev/null
+    exit 1
+  fi
+fi
+""".format(file = file)
+
+
 def replace_symlink(file):
     # On macos, the `readlink` binary doesn't have a `-f` argument like the linux
     # equivilant. As a result, we need another way to fully resolve chaining symlinks.
@@ -290,6 +328,7 @@
     replace_absolute_paths = replace_absolute_paths,
     replace_in_files = replace_in_files,
     replace_sandbox_paths = replace_sandbox_paths,
+    resolve_postfixed_output = resolve_postfixed_output,
     replace_symlink = replace_symlink,
     rm_rf = rm_rf,
     script_extension = script_extension,
