##
## Toolchain versions configuration
##
# When changing this, also update `python-version` in //:ty.toml so the ty
# type checker targets the same Python version as the build toolchain, and
# raise the `requires-python` floor in //tools/python:pyproject.toml.
PYTHON_VERSION = "3.14"

PYTHON_VERSION_SNAKE = PYTHON_VERSION.replace(".", "_")

#
# rules_python block
#
# This repository is the home of the core Python rules -- py_library, py_binary,
# py_test, py_proto_library, and related symbols that provide the basis for Python
# support in Bazel. It also contains package installation rules for integrating
# with PyPI and other indices.
#
# Please find documentation here:
# https://github.com/bazelbuild/rules_python/releases
#
bazel_dep(name = "rules_python", version = "2.3.3")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")

# All supported python toolchains are listed here:
# https://github.com/bazelbuild/rules_python/blob/main/python/versions.bzl
#
# Please see the following documentation on using different Python toolchains:
# https://github.com/bookingcom/rules_python/blob/main/docs/_includes/py_console_script_binary.md#using-a-specific-python-version-directly-from-a-toolchain
python.toolchain(
    # --- BEGIN feature:coverage ---
    # Register rules_python's bundled coverage.py so `bazel coverage` collects
    # line data for py_* targets (the report is empty without it).
    configure_coverage_tool = True,
    # --- END feature:coverage ---
    is_default = True,
    python_version = PYTHON_VERSION,
)
use_repo(python, "python_" + PYTHON_VERSION_SNAKE)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    extra_pip_args = [],
    hub_name = "omniglot-bazel-starter_pip_dependencies",
    python_version = PYTHON_VERSION,
    uv_lock = "//tools/python:uv.lock",
)
use_repo(pip, "omniglot-bazel-starter_pip_dependencies")

# --- BEGIN feature:custom_toolchains ---
#
# Local python runtime toolchain (auto-discovered)
#
# The host_python_discovery extension probes PATH for the newest python3.X
# interpreter (falling back to plain python3) and wires it through
# rules_python's local_runtime_repo / local_runtime_toolchains_repo, so no
# interpreter version or path is pinned here. Select with
# --config=python_host (registered on demand via --extra_toolchains there;
# registering it globally would outrank the hermetic toolchain above).
#
host_python = use_extension("//tools/python/toolchains:host_python_discovery.bzl", "host_python_discovery")
use_repo(host_python, "host_python_repo", "host_python_toolchain")
# --- END feature:custom_toolchains ---

#
# uv toolchain (bundled with rules_python)
#
# rules_python registers its uv toolchains, but the hub stays empty until a
# module calls uv.configure(); the version defaults to rules_python's pin.
# Backs //tools/python:lock (uv lock) and :generate_virtual_env (uv sync).
# https://rules-python.readthedocs.io/en/latest/api/rules_python/python/uv/index.html
#
uv = use_extension("@rules_python//python/uv:uv.bzl", "uv", dev_dependency = True)
uv.configure()
